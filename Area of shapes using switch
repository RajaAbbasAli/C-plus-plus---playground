#include<iostream>
using namespace std;
int main() {
	int choice, length , width , radius, side ;

	cout << "1. Area of Circle" << endl;
	cout << "2. Area of Rectangle" << endl;
	cout << "3. Area of Square" << endl;

	cout << "Enter your choose :";
	cin >> choice;
    
    
    
    
	switch (choice) {

	case 1:
		cout << "Enter radius :";
        cin>>radius;
        cout<<"Area of Circle :"<<3.14 * radius * radius;
		break;
	case 2:
		
        cout<<"Enter length :";
        cin>>length;
        
        cout<<"Enter width :";
        cin>>width;
        cout<<"Area of rectangle :"<<length * width;
		break;
	case 3:
		cout << " Enter side : ";
        cin>>side;
        cout<<"Area of square :"<<side * side;
		break;
	default:
		cout << "invalid input!";
	}
	return 0;
}
