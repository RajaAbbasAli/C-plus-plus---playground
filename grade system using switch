#include<iostream>
using namespace std;
int main() {
	char grade;
	cout << "enter your grade: ";
	cin >> grade;

	switch (grade) {
	case 'A':
    case 'a':
		cout << "excelllent"  ;
		break;
	case 'B':
    case 'b':

		cout << "very good";
		break;
	case 'C':
    case 'c':
		cout << "good";
		break;

	case 'D':
    case 'd':
		cout << "pass";
		break;

	case 'F':
    case 'f':
		cout << "fail" << endl;
	default:
		cout << "invalid !";

	}
	return 0;
}
